{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@2.2.25/oh-my-opencode-slim.schema.json",
  "preset": "newapi",
  "presets": {
    "newapi": {
      "orchestrator": {
        "model": "newapi/glm-5.3",
        "variant": "max",
        "skills": [
          "*",
          "!lark-*",
          "!lark-approval",
          "!lark-apps",
          "!lark-attendance",
          "!lark-base",
          "!lark-calendar",
          "!lark-contact",
          "!lark-doc",
          "!lark-drive",
          "!lark-event",
          "!lark-im",
          "!lark-mail",
          "!lark-markdown",
          "!lark-meeting",
          "!lark-okr",
          "!lark-openapi-explorer",
          "!lark-shared",
          "!lark-sheets",
          "!lark-slides",
          "!lark-task",
          "!lark-whiteboard",
          "!lark-wiki",
          "!lark-workflow-meeting-summary",
          "!lark-workflow-standup-report",
          "!designing-work-loops",
          "!lark-worklog",
          "!managing-lark-project-folder",
          "!yogo-products"
        ],
        "mcps": [
          "gh_grep"
        ],
        "permission": {
          "task": {
            "*": "allow"
          },
          "apply_patch": "allow"
        }
      },
      "oracle": {
        "model": "openai/gpt-6-astra",
        "variant": "xhigh",
        "skills": [
          "find-code-simplifications"
        ],
        "mcps": [],
        "permission": {
          "edit": "deny",
          "write": "deny",
          "apply_patch": "deny",
          "ast_grep_replace": "deny"
        }
      },
      "librarian": {
        "model": "openai/gpt-5.6-luna",
        "variant": "high",
        "skills": [],
        "mcps": [
          "context7",
          "gh_grep"
        ],
        "permission": {
          "edit": "deny",
          "apply_patch": "deny"
        }
      },
      "explorer": {
        "model": "newapi/glm-5.3-flash",
        "variant": "max",
        "skills": [],
        "mcps": [],
        "permission": {
          "edit": "deny",
          "apply_patch": "deny"
        }
      },
      "designer": {
        "model": "newapi/kimi-k2.7",
        "skills": [],
        "mcps": [],
        "permission": {
          "apply_patch": "allow"
        }
      },
      "fixer": {
        "model": "newapi/glm-5.3-flash",
        "variant": "max",
        "skills": [
          "use-modern-go"
        ],
        "mcps": [],
        "permission": {
          "apply_patch": "allow"
        }
      },
      "observer": {
        "model": "newapi/glm-5.3-flash",
        "variant": "max",
        "skills": [],
        "mcps": [],
        "permission": {
          "edit": "deny",
          "apply_patch": "deny"
        }
      },
      "council": {
        "model": "openai/gpt-5.6-sol",
        "variant": "xhigh",
        "skills": [],
        "mcps": []
      }
    }
  },
  "agents": {
    "document-writer": {
      "model": "newapi/glm-5.3-flash",
      "variant": "max",
      "skills": [
        "maintaining-product-engineering-docs",
        "domain-modeling",
        "humanizer",
        "lark-doc",
        "lark-markdown",
        "lark-sheets",
        "lark-base",
        "lark-slides",
        "lark-drive",
        "lark-wiki",
        "lark-whiteboard",
        "lark-shared",
        "yogo-products"
      ],
      "mcps": [],
      "description": "Create/edit formal product, technical and management documents; review expression, structure, consistency and audience fit; exclude internal agent plans/state.",
      "orchestratorPrompt": "- Use document-writer with MODE: WRITE for formal document creation/body edits, or MODE: REVIEW for expression, structure, document-internal consistency, audience fit and readability.\n- Keep internal agent plans/state in the main session and independent platform work with lark-operator. Apply the main-session document/review policy for dispatch and acceptance.",
      "permission": {
        "task": "deny",
        "question": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "gh_grep_*": "deny",
        "context7_*": "deny"
      }
    },
    "lark-operator": {
      "model": "newapi/glm-5.3",
      "variant": "max",
      "skills": [
        "lark-approval",
        "lark-apps",
        "lark-attendance",
        "lark-base",
        "lark-calendar",
        "lark-contact",
        "lark-doc",
        "lark-drive",
        "lark-event",
        "lark-im",
        "lark-mail",
        "lark-markdown",
        "lark-meeting",
        "lark-okr",
        "lark-openapi-explorer",
        "lark-shared",
        "lark-sheets",
        "lark-slides",
        "lark-task",
        "lark-whiteboard",
        "lark-wiki",
        "lark-workflow-meeting-summary",
        "lark-workflow-standup-report",
        "designing-work-loops",
        "lark-worklog",
        "managing-lark-project-folder",
        "yogo-products"
      ],
      "mcps": [],
      "description": "Handle independent Lark reads and platform operations, excluding formal document writing and local file maintenance.",
      "orchestratorPrompt": "Use lark-operator for independent Lark reads/actions; never run platform skills directly. Route local Lark skill files, including lark-skill-maker work, to fixer; operator supplies platform facts and authorized validation only.",
      "permission": {
        "bash": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "write": "deny",
        "apply_patch": "deny",
        "ast_grep_replace": "deny",
        "task": "deny",
        "question": "deny",
        "webfetch": "allow",
        "websearch": "deny",
        "gh_grep_*": "deny",
        "context7_*": "deny"
      }
    }
  },
  "council": {
    "default_preset": "default",
    "presets": {
      "default": {
        "kimi-k3": {
          "model": "newapi/kimi-k3",
          "variant": "max"
        },
        "glm-5.3": {
          "model": "newapi/glm-5.3",
          "variant": "max"
        },
        "gpt-6-astra": {
          "model": "openai/gpt-6-astra",
          "variant": "xhigh"
        },
        "deepseek-v4-pro": {
          "model": "newapi/deepseek-v4-pro",
          "variant": "max"
        }
      }
    }
  },
  "disabled_agents": []
}
